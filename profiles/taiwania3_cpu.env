# ─────────────────────────────────────────────────────────────
# Profile: taiwania3_cpu  (VERIFIED live 2026-09-03)
# Taiwania 3 — CPU partition ct56 — conda-forge GROMACS 2024.4
# Source of truth: memory.md §4.1 + slurm/*.sbatch (same values)
# ─────────────────────────────────────────────────────────────

PROFILE_NAME="Taiwania 3 — CPU ct56 (verified)"

# Engine setup: NCHC modules have only gcc/*; gmx ships in conda env na53_aptamer.
ENV_SETUP='module purge 2>/dev/null || true
module load gcc/13.2.0 2>/dev/null || module load gcc 2>/dev/null || true
source "${HOME}/miniconda3/etc/profile.d/conda.sh" 2>/dev/null || \
source "${HOME}/anaconda3/etc/profile.d/conda.sh" 2>/dev/null || true
conda activate na53_aptamer 2>/dev/null || true'

# CPU: let mdrun auto-select (no GPU flags)
MDRUN_GPU_FLAG=""
PROD_NS=100

# ── SLURM (used by: ./run_simulation.sh submit) ──
PARTITION="ct56"        # 56 cores, 754 GB RAM, 4-day max — verified
ACCOUNT="mst115368"     # verified via sacctmgr
GRES=""                 # no GPU on ct56

TIME_01="01:00:00"  CPUS_01=4   MEM_01=8G
TIME_02="04:00:00"  CPUS_02=28  MEM_02=32G
TIME_03="95:00:00"  CPUS_03=56  MEM_03=32G
TIME_04="02:00:00"  CPUS_04=8   MEM_04=16G

# ── Remote monitoring ──
SSH_HOST="twnia3.nchc.org.tw"     # requires 2FA (app OTP) per login
SSH_USER="u5662994"
REMOTE_DIR="GROMACS_NA53"
