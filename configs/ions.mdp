; ============================================================
; IONS PRE-PROCESSING MDP — GROMACS_NA53
; ============================================================
; Minimal MDP for gmx grompp before gmx genion
; ============================================================

integrator      = steep
emtol           = 1000.0
emstep          = 0.01
nsteps          = 50000

; genion only needs positions + topology for its solvent-group selection, so
; electrostatics are Cut-off here — PME would make grompp fatal on the still-
; un-neutralized DNA (net charge) BEFORE genion has added counter-ions.
; (Production PME settings live in the em/nvt/npt/prod MDPs.)
cutoff-scheme   = Verlet
ns_type         = grid
nstlist         = 1
rcoulomb        = 1.0
rvdw            = 1.0

coulombtype     = Cut-off

vdwtype         = Cut-off
DispCorr        = EnerPres

pbc             = xyz
constraints     = none

nstxout         = 0
nstvout         = 0
nstenergy       = 0
nstlog          = 0
