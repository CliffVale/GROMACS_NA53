# ─────────────────────────────────────────────────────────────
# Profile: taiwania2_twai_gpu  (⚠️ TEMPLATE — commercial TWAI service)
# 台智雲 (TWAI) Taiwania-2 — NVIDIA Tesla V100 32 GB, Slurm.
# NCHC's GROMACS quick-usage guide documents this machine's GPU path
# (research/reports/2026-09-03-ngal-na53-gromacs-litreview.md §5, source S5):
#   module 2023.4 at /opt/ohpc/pkg/gromacs/2023.4  OR  NGC Singularity containers.
# ⚠️ Operator changed from NCHC to TWAI — verify EVERY value live first.
# ─────────────────────────────────────────────────────────────

PROFILE_NAME="TWAI Taiwania-2 — GPU V100 (template)"

ENV_SETUP='module purge 2>/dev/null || true
# CHANGE_ME: source the GROMACS usage script, e.g.
#   source /opt/ohpc/pkg/gromacs/2023.4/gromacs/GromacsUsage.sh
# or load a Singularity/container path per the current TWAI docs.'

# Full GPU offload (adjust if the container/module wants -ntmpi per GPU)
MDRUN_GPU_FLAG="-nb gpu -pme gpu -bonded gpu -update gpu"
PROD_NS=100

# ── SLURM (used by: ./run_simulation.sh submit) ──
PARTITION="CHANGE_ME"     # historically gp1d/gp2d — confirm on live TWAI system
ACCOUNT="CHANGE_ME"       # TWAI billing account/job-account
GRES="CHANGE_ME"          # e.g. gpu:1 (V100)

TIME_01="01:00:00"  CPUS_01=4   MEM_01=8G
TIME_02="04:00:00"  CPUS_02=16  MEM_02=32G
TIME_03="95:00:00"  CPUS_03=16  MEM_03=32G
TIME_04="02:00:00"  CPUS_04=8   MEM_04=16G

# ── Remote monitoring ──
SSH_HOST="CHANGE_ME"      # TWAI login host
SSH_USER="CHANGE_ME"
REMOTE_DIR="GROMACS_NA53"
