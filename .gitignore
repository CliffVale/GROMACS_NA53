# GROMACS output files (large — do not commit)
*.gro
*.tpr
*.xtc
*.trr
*.edr
*.cpt
*.log
*.xvg
*.xdr
*.dhdl
*.energy
*.pdb
!structures/NA53_initial.pdb
!templates/*.pdb

# Topology files (generated — do not commit)
topol.top
topol.tpr
posre*.itp
ions.itp
*processed*
*boxed*
*solvated*
*ionized*
em.*
nvt.*
npt*.*
# ...but the MDP stage configs ARE tracked (the globs above are meant for
# grompp/mdrun output files like em.gro / nvt.tpr / npt2.edr, NOT the inputs)
!em.mdp
!nvt.mdp
!npt.mdp
!npt_free.mdp

# Conda environment
.conda/
*.tar.bz2
*.conda

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/

# OS files
.DS_Store
Thumbs.db
*~
*.swp
*.swo

# Logs (regeneratable)
logs/*.log
logs/*.out
logs/*.err
logs/run_status.txt

# Generated analysis + figure outputs from trial runs (regeneratable)
/analysis/
/results/

# Generated SLURM jobs (run_simulation.sh submit regenerates these)
slurm/jobs/

# ...but the Research SOP run log IS tracked (small JSONL, part of the record)
!research/deepsearch.log

# Temp files
*.tmp
*.bak
prod_mdp_temp.mdp
