; ============================================================
; IONS PRE-PROCESSING MDP — GROMACS_NA53
; ============================================================
; Minimal MDP for gmx grompp before gmx genion
; ============================================================

integrator      = steep
emtol           = 1000.0
emstep          = 0.01
nsteps          = 50000

cutoff-scheme   = Verlet
ns_type         = grid
nstlist         = 1
rcoulomb        = 1.0
rvdw            = 1.0

coulombtype     = PME
pme_order       = 4
fourierspacing  = 0.12

vdwtype         = Cut-off
DispCorr        = EnerPres

pbc             = xyz
constraints     = none

nstxout         = 0
nstvout         = 0
nstenergy       = 0
nstlog          = 0
