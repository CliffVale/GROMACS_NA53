# ─────────────────────────────────────────────────────────────
# Profile: local_gpu  (workstation GPU — CachyOS / GTX 1650 Ti)
# Interactive foreground runs: ./run_simulation.sh start
# Proven rate: ~257 ns/day on the 12-bp 1BNA (26k atoms) → NA53 75-nt (~50–65k atoms)
# (75-nt NA53 ~50-65k atoms) is slower; keep PROD_NS small for dev/trials.
# ─────────────────────────────────────────────────────────────

PROFILE_NAME="Local workstation GPU (GTX 1650 Ti / CachyOS)"

# Local gmx build used in past sessions (2025.3, GPU-enabled); conda fallback.
ENV_SETUP='if [ -d "$HOME/gromacs-2025.3/build/bin" ]; then
  export PATH="$HOME/gromacs-2025.3/build/bin:$PATH"
fi
hash -r 2>/dev/null || true'

# Full offload — 03_production.sh expands this into -pme/-bonded/-update flags
MDRUN_GPU_FLAG="-nb gpu"
PROD_NS=20                 # dev/trial length; raise once benchmarked

# No SLURM on this machine — leave empty
PARTITION=""
ACCOUNT=""
GRES=""
TIME_01="00:30:00" CPUS_01=4 MEM_01=8G
TIME_02="02:00:00" CPUS_02=8 MEM_02=16G
TIME_03="24:00:00" CPUS_03=8 MEM_03=16G
TIME_04="01:00:00" CPUS_04=4 MEM_04=8G

# Monitoring is local (this machine)
SSH_HOST=""
SSH_USER=""
REMOTE_DIR=""
