# ─────────────────────────────────────────────────────────────
# Profile: taiwania3_gpu  (⚠️ TEMPLATE — not yet granted/verified)
# Taiwania 3 — GPU partition (ngs*gpu Tesla / gpu-amd A100 seen in sinfo)
# Fill the CHANGE_ME values from the live checklist
# (docs/HPC_GPU_OPTIONS.md §5), then remove this comment block.
# ─────────────────────────────────────────────────────────────

PROFILE_NAME="Taiwania 3 — GPU (template)"

# ⚠️ ENGINE: conda-forge `gromacs` is a CPU build. A CUDA-enabled gmx is required
# for real GPU offload — options: NGC Singularity container, a source build done
# on a GPU node, or an NCHC-provided module. Verify with:  gmx --version  (look for
# "Acceleration: ... CUDA ..."). Set ENV_SETUP to load whatever delivers that gmx.
ENV_SETUP='module purge 2>/dev/null || true
# CHANGE_ME: load/source the CUDA-enabled GROMACS here (container, module, or
# activate the conda env that provides it)'

# Full GPU offload once a CUDA build is active
MDRUN_GPU_FLAG="-nb gpu -pme gpu -bonded gpu -update gpu"
PROD_NS=100

# ── SLURM (used by: ./run_simulation.sh submit) ──
# Live sinfo hints (2026-08-31): ngs1gpu = gpu:tesla:8(S:0-1), 56 cpus, 754 GB;
# gpu-amd = gpu:ampere:4, 128 cpus. Confirm which your project can use.
PARTITION="CHANGE_ME"     # e.g. gpu-amd | ngs1gpu | <granted partition>
ACCOUNT="mst115368"       # verified account — keep
GRES="CHANGE_ME"          # e.g. gpu:ampere:1 | gpu:tesla:1

TIME_01="01:00:00"  CPUS_01=4   MEM_01=8G
TIME_02="04:00:00"  CPUS_02=16  MEM_02=32G
TIME_03="95:00:00"  CPUS_03=16  MEM_03=32G   # 1 GPU node: cores are helpers, not the engine
TIME_04="02:00:00"  CPUS_04=8   MEM_04=16G

# ── Remote monitoring ──
SSH_HOST="twnia3.nchc.org.tw"     # requires 2FA (app OTP) per login
SSH_USER="u5662994"
REMOTE_DIR="GROMACS_NA53"
